# MachSight-Simulator environment configuration
# Copy this to .env and adjust as needed

# ── Server ──────────────────────────────────────────────────────────────────
SIM_HOST=0.0.0.0
SIM_PORT=8765

# ── Machine identity ─────────────────────────────────────────────────────────
MACHINE_ID=rc-sim-01
ASSET_TYPE=rc_vehicle

# ── Simulation engine ────────────────────────────────────────────────────────
SIM_FREQUENCY_HZ=100          # Internal physics loop frequency
CURRENT_SENSOR_HZ=50          # Motor current sampling rate
RPM_SENSOR_HZ=20              # Wheel RPM sampling rate
ULTRASONIC_SENSOR_HZ=10       # Ultrasonic distance sampling rate

# ── Vehicle ──────────────────────────────────────────────────────────────────
MAX_RPM=400.0                 # Maximum wheel RPM
MAX_ACCELERATION=120.0        # RPM/s maximum acceleration
MAX_DECELERATION=200.0        # RPM/s maximum deceleration
ROLLING_RESISTANCE=0.05       # Dimensionless friction coefficient
MOTOR_RESPONSE_TIME=0.25      # s — first-order motor time constant
VEHICLE_MASS_KG=1.2           # kg
WHEEL_RADIUS_M=0.033          # m
PWM_MIN=0
PWM_MAX=255

# ── Battery ──────────────────────────────────────────────────────────────────
BATTERY_NOMINAL_V=7.4         # V (2S LiPo nominal)
BATTERY_CAPACITY_MAH=2000.0

# ── Sensor noise ─────────────────────────────────────────────────────────────
ULTRASONIC_NOISE_SIGMA=1.2    # cm
CURRENT_NOISE_SIGMA=0.05      # A
RPM_NOISE_SIGMA=3.0           # RPM

# ── Ultrasonic sensor limits ─────────────────────────────────────────────────
ULTRASONIC_MIN_CM=2.0
ULTRASONIC_MAX_CM=400.0

# ── Network imperfections (disabled by default) ──────────────────────────────
NETWORK_PACKET_LOSS=0.0       # probability 0.0–1.0
NETWORK_LATENCY_MS=0.0        # ms base latency
NETWORK_JITTER_MS=0.0         # ms jitter

# ── MachSight upstream target ─────────────────────────────────────────────────
MACHSIGHT_WS_URL=ws://localhost:8000/telemetry/ingest

# ── Logging / recording ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
RECORD_RUNS=false
RUNS_DIR=runs
